# ============================================================================
# 本文件 = 首次启动的默认值 + 部署级参数。
# 其余配置项请在【前端设置页】里改：它们存进 SQLite 的 settings 表，
# 改完立即生效（标「需重启」的项除外），并能一键导出/导入来分享或备份。
# 只有 PORT / DB_FILE 这类启动参数必须留在本文件。
# ============================================================================

# ── 服务 ────────────────────────────────────────────────────────────────
PORT=3100
# SQLite 库文件（相对 Server 目录）
DB_FILE=data/hub.db
# 首页排期缓存有效期（毫秒），默认 10 分钟
CACHE_TTL_MS=600000

# ── 数据源：Mikan —— 排期主源（官方 mikanani.me，镜像 mikanime.tv） ─────
MIKAN_BASE_URL=https://mikanime.tv

# ── 数据源：Bangumi —— 评分 / 评分人数 / 标签（官方 api.bgm.tv，镜像 bgmapi.anibt.net） ──
BGM_API_BASE=https://bgmapi.anibt.net
# 官方接口要求带 UA；留空则用内置默认
BGM_USER_AGENT=
# 官方接口可选 token（镜像不校验）
BGM_TOKEN=
BGM_TIMEOUT_MS=20000

# ── 评分显示阈值：评分人数少于这个值就不显示评分（新番人少，分数没参考意义） ──
MIN_RATING_TOTAL=100

# ── 图片缓存（出图接口落盘目录 + 浏览器缓存时长） ─────────────────────
IMAGE_CACHE_DIR=data/img
IMAGE_MAX_AGE_SEC=2592000

# ── 后台守护进程（两个触发：补齐 bgmId 为空的作品 / 今年番剧每日更新）──────
# 是否跟随 API 服务一起跑（默认 1，省得再开终端）；独立守护：设为 0 并 npm run worker
WORKER_INLINE=1
# 每条之间的间隔（毫秒）—— 别把 Mikan / Bangumi 打爆
WORKER_GAP_MS=350
# 两个队列都没有任务时的休眠时长（毫秒）
WORKER_IDLE_MS=30000
# 每日更新的固定时刻（HH:MM，服务器本地时间）：到点后把「今年」的番逐条刷一遍整份档案
WORKER_DAILY_AT=04:00
# 连续几次拿不到 bgmId（Mikan 详情页确实没挂 Bangumi 链接）就退出补齐队列，避免死循环重试
WORKER_MISS_LIMIT=3
# 超限之后隔多久再试一次（小时，默认一周）
WORKER_MISS_RETRY_HOURS=168
# 每日更新覆盖的年份（不填 = 当年；0 = 不限年份，谨慎）
# WORKER_STALE_YEAR=2026

# ── qBittorrent（下载页才用，首页不需要） ─────────────────────────────
QB_BASE_URL=
QB_API_KEY=

# ── AI（可选功能：资源标签解析 / 集数识别）──────────────────────────────
# 不配 AI_API_KEY 也能正常跑：相关接口会回 AI_DISABLED(501)，前端显示「未配置」。
# 默认按 DeepSeek 配；换 OpenAI / Moonshot / 本地 Ollama、vLLM 都只需改这两个（都兼容 /chat/completions）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=sk-751e7246d0884eaf97ea343a03b6a54a
# 单次调用超时（毫秒）
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4096
# 一次最多分析多少条文件名（超出的截断）
AI_MAX_TITLES=120
# 结果缓存时长（毫秒）：标签 30 分钟 / 集数 24 小时
AI_TAG_CACHE_TTL_MS=1800000
AI_EPISODE_CACHE_TTL_MS=86400000
